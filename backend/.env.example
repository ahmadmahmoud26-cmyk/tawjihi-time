# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/tawjihi_time
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tawjihi_time
DATABASE_USER=tawjihi_user
DATABASE_PASSWORD=your_secure_password

# Super Admin Credentials (must be provided via environment secrets in production)
SUPER_ADMIN_EMAIL=your_super_admin_email@example.com
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRY=7d

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
