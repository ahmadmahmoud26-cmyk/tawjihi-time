# Server Configuration
PORT=3001
NODE_ENV=production

# Session Security
SESSION_SECRET=replace-with-a-long-random-secret

# Super Admin Credentials (Set via environment variables, NOT in source code)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-unique-strong-password

# Google OAuth Configuration (Optional, leave empty if not using Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# Database
DB_PATH=./data/tawjihi.sqlite

# CORS Configuration for Production
FRONTEND_URL=https://your-production-domain.example

# TLS/HTTPS (if using production TLS)
# TLS_KEY_FILE=/path/to/key.pem
# TLS_CERT_FILE=/path/to/cert.pem
